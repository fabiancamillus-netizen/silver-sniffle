artifacts = ["/app/posterior_summary.json"]

[task]
name = "afterquery-zi-mcmc"

[metadata]
author_name = "Bernard Omolo"
author_email = "bomolo64@gmail.com"
difficulty_explanation = "This task requires implementing a custom MCMC sampler for a non-standard model with a latent random intercept and zero-inflation. Frontier agents often fail because they either rely on existing libraries (which are not allowed) or make subtle errors in deriving conditional posteriors and tuning proposal distributions. The model's hierarchical structure and the zero-inflation component make it more complex than a standard Poisson GLM, and achieving accurate posterior summaries demands careful convergence diagnostics."
solution_explanation = "The reference solution uses a Metropolis-within-Gibbs algorithm. The latent random effects u_i are integrated out analytically or sampled via data augmentation. The solution implements block updates for regression coefficients, a random-walk Metropolis update for sigma on the log scale, and a Metropolis-Hastings update for the zero-inflation probability p. The chain is run for 30,000 iterations with 10,000 burn-in, and posterior summaries are computed from the remaining samples."
verification_explanation = "The verifier compares the agent's posterior summary JSON against a precomputed ground truth obtained from a long MCMC run (100,000 iterations) using the same data and priors. Tolerance thresholds are set based on the variability observed across multiple long runs: means within 0.05, standard deviations within 0.05, and quantiles within 0.15 for each parameter. The verifier also checks that the output file exists, is valid JSON, and contains all required keys."
category = "ML"
subcategory = "Training"
